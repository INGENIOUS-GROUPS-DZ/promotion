
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#176b43">
  <meta name="description" content="Royal Champignon Algeria : culture et production de champignons alimentaires à Sidi Hamad, Meftah, Blida, Algérie.">
  <meta property="og:title" content="Royal Champignon Algeria">
  <meta property="og:description" content="La fraîcheur naturelle, la qualité et l'avenir de la culture des champignons en Algérie.">
  <meta property="og:type" content="website">
  <title>Royal Champignon Algeria | Culture de champignons</title>

  <style>
    :root {
      --green: #176b43;
      --green-dark: #0b3827;
      --green-light: #eaf6ee;
      --mint: #f5faf6;
      --gold: #c8a85b;
      --text: #20372b;
      --muted: #6d7c72;
      --white: #ffffff;
      --shadow: 0 16px 45px rgba(16, 75, 45, .09);
      --radius: 24px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; scroll-padding-top: 85px; }

    body {
      font-family: "Segoe UI", Arial, sans-serif;
      background: var(--white);
      color: var(--text);
      line-height: 1.8;
      overflow-x: hidden;
    }

    a { color: inherit; text-decoration: none; }
    button, input, textarea, select { font: inherit; }
    button, a { -webkit-tap-highlight-color: transparent; }
    section { padding: 90px 6%; }
    .container { width: min(1180px, 100%); margin: auto; }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 50px;
      background: var(--green-light);
      color: var(--green);
      font-size: .86rem;
      font-weight: 800;
      margin-bottom: 18px;
    }

    .eyebrow::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--gold);
    }

    .section-head {
      max-width: 720px;
      margin: 0 auto 45px;
      text-align: center;
    }

    .section-head h2 {
      font-size: clamp(1.9rem, 4vw, 3rem);
      line-height: 1.3;
      color: var(--green-dark);
      margin-bottom: 15px;
    }

    .section-head p { color: var(--muted); }
    .green-text { color: var(--green); }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 13px 23px;
      border: 1px solid transparent;
      border-radius: 12px;
      font-weight: 800;
      transition: .25s ease;
      cursor: pointer;
    }

    .btn:hover { transform: translateY(-3px); }

    .btn-primary {
      background: var(--green);
      color: white;
      box-shadow: 0 8px 24px rgba(23, 107, 67, .2);
    }

    .btn-primary:hover { background: var(--green-dark); }

    .btn-outline {
      border-color: rgba(23, 107, 67, .25);
      color: var(--green);
      background: white;
    }

    .btn-outline:hover { background: var(--green-light); }

    /* Navigation */
    .navbar {
      height: 82px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 6%;
      background: rgba(255,255,255,.95);
      backdrop-filter: blur(15px);
      border-bottom: 1px solid #edf2ee;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .brand { display: flex; align-items: center; gap: 11px; }

    .brand-icon {
      width: 45px;
      height: 45px;
      border-radius: 14px;
      background: var(--green);
      display: grid;
      place-items: center;
      color: white;
      font-size: 25px;
      flex-shrink: 0;
    }

    .brand-name {
      color: var(--green-dark);
      font-weight: 900;
      font-size: 1rem;
      line-height: 1.35;
    }

    .brand-name small {
      display: block;
      font-size: .7rem;
      color: var(--gold);
      letter-spacing: 1.5px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 23px;
      list-style: none;
    }

    .nav-links a { font-size: .9rem; font-weight: 700; }
    .nav-links a:hover { color: var(--green); }
    .menu-toggle { display: none; }

    /* Hero */
    .hero {
      position: relative;
      min-height: 650px;
      display: flex;
      align-items: center;
      padding: 75px 6%;
      overflow: hidden;
      background:
        radial-gradient(circle at 8% 15%, rgba(200,168,91,.14), transparent 25%),
        radial-gradient(circle at 90% 85%, rgba(23,107,67,.1), transparent 30%),
        linear-gradient(135deg, #ffffff 0%, #f5faf6 55%, #eaf6ee 100%);
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 440px;
      height: 440px;
      border: 1px solid rgba(23,107,67,.09);
      border-radius: 50%;
      left: -150px;
      top: -180px;
    }

    .hero-grid {
      position: relative;
      z-index: 1;
      width: min(1180px, 100%);
      margin: auto;
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      align-items: center;
      gap: 55px;
    }

    .hero h1 {
      font-size: clamp(2.6rem, 5.5vw, 4.8rem);
      line-height: 1.18;
      letter-spacing: -1.5px;
      color: var(--green-dark);
      margin-bottom: 22px;
    }

    .hero h1 span { color: var(--green); }

    .hero-description {
      font-size: 1.08rem;
      max-width: 570px;
      color: #627268;
      margin-bottom: 28px;
    }

    .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

    .hero-note {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--muted);
      font-size: .85rem;
      margin-top: 25px;
    }

    .hero-note span { color: var(--green); font-size: 1.2rem; }

    .hero-art {
      position: relative;
      min-height: 450px;
      display: grid;
      place-items: center;
    }

    .art-circle {
      width: min(410px, 100%);
      aspect-ratio: 1;
      border-radius: 50%;
      background: linear-gradient(145deg, #d8eddd, #f7fbf7);
      border: 1px solid rgba(23,107,67,.12);
      display: grid;
      place-items: center;
      position: relative;
      box-shadow: var(--shadow);
    }

    .art-circle::before, .art-circle::after {
      content: "";
      position: absolute;
      border-radius: 50%;
      border: 1px solid rgba(23,107,67,.12);
    }

    .art-circle::before { inset: 20px; }
    .art-circle::after { inset: -20px; border-style: dashed; }

    .mushroom-illustration {
      width: 90%;
      position: relative;
      z-index: 1;
      filter: drop-shadow(0 20px 15px rgba(26,65,42,.12));
    }

    .floating-tag {
      position: absolute;
      background: white;
      border: 1px solid #e7efe8;
      border-radius: 16px;
      padding: 13px 17px;
      box-shadow: var(--shadow);
      font-weight: 800;
      z-index: 2;
    }

    .floating-tag small {
      display: block;
      color: var(--muted);
      font-weight: 500;
      font-size: .76rem;
    }

    .tag-one { top: 55px; right: -5px; }
    .tag-two { bottom: 45px; left: -5px; }

    /* Highlights */
    .highlights { padding: 0 6% 55px; }

    .highlight-grid {
      width: min(1050px, 100%);
      margin: auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border: 1px solid #e9f0ea;
      border-radius: 20px;
      overflow: hidden;
      background: white;
      box-shadow: var(--shadow);
    }

    .highlight { padding: 25px 18px; text-align: center; }
    .highlight + .highlight { border-left: 1px solid #e9f0ea; }
    .highlight .symbol { font-size: 1.8rem; margin-bottom: 5px; }
    .highlight h3 { font-size: 1rem; color: var(--green-dark); }
    .highlight p { color: var(--muted); font-size: .84rem; }

    /* About */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 55px;
    }

    .about-panel {
      padding: 35px;
      background: var(--mint);
      border: 1px solid #e5efe7;
      border-radius: var(--radius);
      position: relative;
      overflow: hidden;
    }

    .about-panel::after {
      content: "ROYAL";
      position: absolute;
      bottom: -30px;
      left: -10px;
      color: rgba(23,107,67,.055);
      font-size: 6rem;
      font-weight: 900;
    }

    .about-emblem {
      width: 82px;
      height: 82px;
      background: white;
      border: 1px solid #e5efe7;
      border-radius: 24px;
      display: grid;
      place-items: center;
      font-size: 3rem;
      margin-bottom: 24px;
    }

    .about-panel h3 {
      color: var(--green-dark);
      font-size: 1.6rem;
      margin-bottom: 10px;
    }

    .about-copy h2 {
      color: var(--green-dark);
      font-size: clamp(1.9rem, 4vw, 2.8rem);
      line-height: 1.35;
      margin-bottom: 18px;
    }

    .about-copy p { color: var(--muted); margin-bottom: 15px; }
    .check-list { list-style: none; margin: 20px 0; }

    .check-list li {
      display: flex;
      align-items: flex-start;
      gap: 11px;
      margin-bottom: 10px;
      font-weight: 700;
    }

    .check-list li span {
      display: grid;
      place-items: center;
      background: var(--green-light);
      color: var(--green);
      width: 25px;
      height: 25px;
      border-radius: 50%;
      flex-shrink: 0;
      margin-top: 2px;
    }

    /* Products */
    .products-section { background: var(--mint); }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .product-card {
      background: white;
      border: 1px solid #e8f0e9;
      border-radius: 22px;
      padding: 24px;
      transition: .25s ease;
      overflow: hidden;
    }

    .product-card:hover {
      transform: translateY(-7px);
      box-shadow: var(--shadow);
      border-color: #c9e2d0;
    }

    .product-visual {
      height: 190px;
      border-radius: 17px;
      display: grid;
      place-items: center;
      background: linear-gradient(145deg, #eaf6ee, #f9fcf9);
      margin-bottom: 20px;
      font-size: 5rem;
      position: relative;
      overflow: hidden;
    }

    .product-visual::before {
      content: "";
      width: 130px;
      height: 130px;
      background: rgba(23,107,67,.07);
      border-radius: 50%;
      position: absolute;
    }

    .product-visual span { position: relative; z-index: 1; }
    .product-card h3 { color: var(--green-dark); font-size: 1.3rem; margin-bottom: 8px; }
    .product-card p { color: var(--muted); font-size: .94rem; }

    .product-tag {
      display: inline-block;
      margin-top: 15px;
      background: var(--green-light);
      color: var(--green);
      padding: 5px 12px;
      border-radius: 50px;
      font-size: .8rem;
      font-weight: 800;
    }

    /* Nutrition */
    .nutrition-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 17px;
    }

    .nutrition-card {
      padding: 25px 18px;
      border: 1px solid #e7eee8;
      border-radius: 18px;
      text-align: center;
      background: white;
      transition: .25s;
    }

    .nutrition-card:hover {
      border-color: var(--green);
      background: var(--mint);
    }

    .nutrition-icon { font-size: 2rem; margin-bottom: 12px; }
    .nutrition-card h3 { color: var(--green); margin-bottom: 8px; }
    .nutrition-card p { font-size: .87rem; color: var(--muted); }

    .nutrition-note {
      background: #fffaf0;
      border-left: 4px solid var(--gold);
      padding: 17px 20px;
      border-radius: 10px;
      margin-top: 25px;
      color: #69572e;
      font-size: .9rem;
    }

    /* Cultivation */
    .process-section { background: var(--green-dark); color: white; }
    .process-section .section-head h2 { color: white; }
    .process-section .section-head p { color: #c3d8ca; }
    .process-section .eyebrow { background: rgba(255,255,255,.1); color: #d8f0df; }

    .process-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .process-card {
      border: 1px solid rgba(255,255,255,.15);
      background: rgba(255,255,255,.055);
      border-radius: 18px;
      padding: 24px 20px;
    }

    .process-number {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      background: var(--gold);
      color: var(--green-dark);
      font-weight: 900;
      margin-bottom: 20px;
    }

    .process-card h3 { margin-bottom: 9px; font-size: 1.1rem; }
    .process-card p { color: #c5d9cc; font-size: .88rem; }

    /* Quality */
    .quality-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .quality-card {
      padding: 28px;
      border-radius: 20px;
      border: 1px solid #e8f0e9;
      background: white;
    }

    .quality-icon {
      width: 55px;
      height: 55px;
      display: grid;
      place-items: center;
      background: var(--green-light);
      border-radius: 17px;
      font-size: 1.6rem;
      margin-bottom: 18px;
    }

    .quality-card h3 { color: var(--green-dark); margin-bottom: 8px; }
    .quality-card p { color: var(--muted); font-size: .92rem; }

    /* Call to action */
    .contact-banner { padding: 0 6% 90px; }

    .banner-inner {
      width: min(1180px, 100%);
      margin: auto;
      padding: 50px;
      background:
        radial-gradient(circle at 90% 10%, rgba(200,168,91,.19), transparent 28%),
        linear-gradient(120deg, #176b43, #0b3827);
      color: white;
      border-radius: 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .banner-inner h2 {
      font-size: clamp(1.7rem, 3.5vw, 2.6rem);
      line-height: 1.35;
      margin-bottom: 10px;
    }

    .banner-inner p { color: #d4e6d9; max-width: 650px; }

    .banner-inner .btn {
      background: var(--gold);
      color: var(--green-dark);
      flex-shrink: 0;
    }

    /* Contact */
    .contact-grid {
      display: grid;
      grid-template-columns: .85fr 1.15fr;
      gap: 35px;
      align-items: start;
    }

    .contact-info h3 {
      color: var(--green-dark);
      font-size: 1.65rem;
      margin-bottom: 12px;
    }

    .contact-info > p { color: var(--muted); margin-bottom: 24px; }

    .contact-item {
      display: flex;
      gap: 15px;
      align-items: flex-start;
      padding: 17px 0;
      border-bottom: 1px solid #e9f0ea;
    }

    .contact-icon {
      width: 45px;
      height: 45px;
      border-radius: 13px;
      background: var(--green-light);
      display: grid;
      place-items: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }

    .contact-item small { color: var(--muted); display: block; }
    .contact-item strong { color: var(--green-dark); }

    .contact-form {
      padding: 30px;
      border-radius: 22px;
      border: 1px solid #e5eee7;
      box-shadow: var(--shadow);
      background: white;
    }

    .contact-form h3 { color: var(--green-dark); font-size: 1.45rem; margin-bottom: 5px; }
    .form-intro { color: var(--muted); font-size: .9rem; margin-bottom: 22px; }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .field { margin-bottom: 17px; }

    .field label {
      display: block;
      font-weight: 800;
      font-size: .88rem;
      margin-bottom: 7px;
    }

    .field input, .field textarea, .field select {
      width: 100%;
      padding: 13px 14px;
      border: 1px solid #dfe9e1;
      border-radius: 11px;
      outline: none;
      background: #fcfefc;
      color: var(--text);
      transition: .2s;
    }

    .field input:focus, .field textarea:focus, .field select:focus {
      border-color: var(--green);
      box-shadow: 0 0 0 3px rgba(23,107,67,.08);
    }

    .field textarea { resize: vertical; min-height: 115px; }
    .contact-form .btn { width: 100%; }
    .form-message { color: var(--muted); font-size: .8rem; margin-top: 12px; }

    /* FAQ */
    .faq-section { background: var(--mint); }
    .faq-list { max-width: 850px; margin: auto; }

    .faq-list details {
      background: white;
      border: 1px solid #e5eee7;
      border-radius: 14px;
      margin-bottom: 12px;
      padding: 18px 22px;
    }

    .faq-list summary {
      font-weight: 800;
      color: var(--green-dark);
      cursor: pointer;
    }

    .faq-list details p { color: var(--muted); margin-top: 12px; }

    /* Footer */
    footer {
      background: #082a1d;
      color: white;
      padding: 45px 6% 20px;
    }

    .footer-grid {
      width: min(1180px, 100%);
      margin: auto;
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 35px;
      padding-bottom: 35px;
    }

    .footer-brand { color: white; font-size: 1.2rem; font-weight: 900; }
    .footer-description { color: #b8cfc0; margin-top: 12px; max-width: 390px; font-size: .9rem; }
    footer h4 { margin-bottom: 14px; color: #e4d19c; }
    .footer-links { list-style: none; }
    .footer-links li { margin-bottom: 9px; color: #c7d9cd; font-size: .9rem; }
    .footer-links a:hover { color: white; }

    .footer-bottom {
      width: min(1180px, 100%);
      margin: auto;
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,.13);
      color: #a9c0b1;
      font-size: .82rem;
      display: flex;
      justify-content: space-between;
      gap: 15px;
      flex-wrap: wrap;
    }

    .whatsapp-float {
      position: fixed;
      left: 22px;
      bottom: 22px;
      z-index: 900;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: #20c765;
      color: white;
      display: grid;
      place-items: center;
      font-size: 1.9rem;
      box-shadow: 0 7px 25px rgba(0,0,0,.2);
      transition: .2s;
    }

    .whatsapp-float:hover { transform: scale(1.08); }

    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity .6s ease, transform .6s ease;
    }

    .reveal.visible { opacity: 1; transform: translateY(0); }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
      }
      .reveal { opacity: 1; transform: none; }
    }

    @media (max-width: 950px) {
      .nav-links { gap: 13px; }
      .nav-links a { font-size: .82rem; }
      .hero-grid { gap: 25px; }
      .product-grid { grid-template-columns: repeat(2, 1fr); }
      .nutrition-grid { grid-template-columns: repeat(2, 1fr); }
      .process-grid { grid-template-columns: repeat(2, 1fr); }
      .about-grid { gap: 30px; }
    }

    @media (max-width: 760px) {
      section { padding: 65px 5%; }
      .navbar { padding: 0 5%; height: 72px; }
      .brand-name { font-size: .85rem; }
      .brand-name small { font-size: .62rem; }
      .brand-icon { width: 39px; height: 39px; }

      .menu-toggle {
        display: grid;
        place-items: center;
        width: 43px;
        height: 43px;
        border: 1px solid #e2ece4;
        border-radius: 11px;
        background: white;
        color: var(--green);
        font-size: 1.5rem;
        cursor: pointer;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 71px;
        right: 0;
        left: 0;
        padding: 18px 5% 25px;
        background: white;
        border-bottom: 1px solid #e5eee7;
        box-shadow: var(--shadow);
        flex-direction: column;
        align-items: stretch;
        gap: 0;
      }

      .nav-links.open { display: flex; }
      .nav-links li a { display: block; padding: 10px 0; font-size: .95rem; }

      .hero { padding: 55px 5% 70px; min-height: auto; }
      .hero-grid { grid-template-columns: 1fr; gap: 15px; }
      .hero-copy { text-align: center; }
      .hero-description { margin-right: auto; margin-left: auto; }
      .hero-actions, .hero-note { justify-content: center; }
      .hero-art { min-height: 340px; margin-top: 15px; }
      .art-circle { width: min(300px, 80vw); }
      .tag-one { right: 0; top: 20px; }
      .tag-two { left: 0; bottom: 20px; }
      .floating-tag { padding: 10px 12px; font-size: .83rem; }

      .highlights { padding: 0 5% 35px; }
      .highlight-grid { grid-template-columns: 1fr; }
      .highlight { padding: 18px; }
      .highlight + .highlight { border-left: 0; border-top: 1px solid #e9f0ea; }

      .about-grid, .contact-grid { grid-template-columns: 1fr; }
      .about-panel { padding: 28px; }
      .product-grid, .quality-grid { grid-template-columns: 1fr; }
      .process-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
      .process-card { padding: 19px 15px; }
      .banner-inner { padding: 30px 24px; flex-direction: column; align-items: flex-start; }
      .contact-banner { padding: 0 5% 65px; }
      .contact-form { padding: 23px 18px; }
      .form-row { grid-template-columns: 1fr; gap: 0; }
      .footer-grid { grid-template-columns: 1fr; gap: 25px; }
      .footer-bottom { flex-direction: column; }
    }

    @media (max-width: 380px) {
      .process-grid, .nutrition-grid { grid-template-columns: 1fr; }
      .hero h1 { font-size: 2.35rem; }
      .hero-actions .btn { width: 100%; }
    }
  </style>
</head>

<body>

<header class="navbar">
